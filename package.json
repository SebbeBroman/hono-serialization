{
  "name": "hono-serialization",
  "version": "0.1.0",
  "description": "Opt-in Hono serialize/deserialize via a request header. Bring your own superjson, seroval, devalue or cbor-x.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hono",
    "rpc",
    "serialization",
    "serializer",
    "superjson",
    "seroval",
    "devalue",
    "cbor-x"
  ],
  "license": "MIT",
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "cbor-x": "^1.6.6",
    "devalue": "^5.3.2",
    "hono": "^4.9.8",
    "seroval": "^1.6.4",
    "superjson": "^2.2.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/client.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "splitting": true,
    "sourcemap": true,
    "clean": true
  }
}
