{
  "name": "hono-serialization",
  "version": "0.0.1",
  "description": "Opt-in Hono serialize/deserialize via a request header. Bring your own superjson, seroval, devalue or cbor-x.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check:release",
    "check:package": "tsc -p tsconfig.package.json && node checks/package-boundaries.mjs",
    "check:install": "node checks/package-install.mjs",
    "check:release": "npm run typecheck && npm test && npm run build && npm run check:package && npm run check:install"
  },
  "keywords": [
    "hono",
    "rpc",
    "serialization",
    "serializer",
    "superjson",
    "seroval",
    "devalue",
    "cbor-x"
  ],
  "license": "MIT",
  "peerDependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "cbor-x": "^1.6.6",
    "devalue": "^6.0.2",
    "hono": "^4.13.13",
    "seroval": "^1.6.9",
    "superjson": "^2.2.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/client.ts",
      "src/codec.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": {
      "compilerOptions": {
        "ignoreDeprecations": "6.0"
      }
    },
    "splitting": true,
    "sourcemap": true,
    "clean": true
  },
  "author": "Sebastian Broman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebbeBroman/hono-serialization.git"
  },
  "homepage": "https://github.com/SebbeBroman/hono-serialization#readme",
  "bugs": {
    "url": "https://github.com/SebbeBroman/hono-serialization/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
